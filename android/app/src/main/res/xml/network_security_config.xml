<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Metro bundler en desarrollo: requiere cleartext HTTP a localhost -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Backend: doble pinning — cert hoja + CA intermedia como respaldo -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api-financieraepik.azurewebsites.net</domain>
        <pin-set expiration="2029-06-19">
            <!-- Pin primario: cert hoja *.azurewebsites.net — expira 2027-02-24 -->
            <pin digest="SHA-256">FMN/4rrRGLs0GOYT9rhanFX+hz3hC2zy7I7wr4H9w/8=</pin>
            <!-- Pin respaldo: Microsoft TLS RSA Root G2 — expira 2029-06-19 (root, muy estable) -->
            <pin digest="SHA-256">SwPJlmyGOywAipWl7ZJUBwRIx7IZ0oMQL2psW26OKs0=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
